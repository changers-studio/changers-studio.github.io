{
	"emmet.includeLanguages": {
		"svg": "html",
		"vue-html": "html",
		"javascriptreact": "html",
		"typescriptreact": "html",
		"pug": "html"
	},
	"html.suggest.html5": true,
	"editor.quickSuggestions": {
		"strings": true
	},
	"css.customData": ["./style-data.json"],
	"scss.customData": ["./style-data.json"],
	"html.customData": ["./html-data.json"],
	"editor.quickSuggestions": {
		"strings": true
	},
	"html-css-class-completion.includeGlobPattern": "**/{src/scss,app/css}/**/*.{css,scss}",
	"html-css-class-completion.enableEmmetSupport": true,
	"scss.trace.server": "messages",
	"git.enabled": false
}
